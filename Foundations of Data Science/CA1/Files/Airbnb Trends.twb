                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='91530' id='7' param='vert' removable='false' type-v2='layout-flow' w='98756' x='622' y='7281'>
              <zone h='91530' id='1' param='vert' removable='false' type-v2='layout-flow' w='98756' x='622' y='7281'>
                <zone fixed-size='79' h='11738' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98756' x='622' y='7281' />
                <zone h='79792' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98756' x='622' y='19019'>
                  <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Introduction' captured-sheet='Introduction' id='1'>
                        <capturedDeltas>
                          <dashboard name='Introduction'>
                            <zone id='3'>
                              <formatted-text>
                                <run bold='true' fontcolor='#e15759' fontsize='24'>Airbnb Analysis</run>
                                <run>Æ&#10;&#10;</run>
                                <run fontcolor='#000000' fontsize='12'>This Airbnb Analysis explores the dynamics of Airbnb listings across New York City by examining data related to pricing, location, availability, reviews, and room types. The project utilizes two datasets: Airbnb_Listings.xls, which contains detailed information about each listing such as price, host details, review statistics, and availability, and Neighborhood_Locations.xlsx, which provides location data including latitude, longitude, and neighborhood classification. The goal of this analysis is to identify trends and relationships within the data, particularly those that relate to pricing behavior, geographical distribution, and listing popularity. The analysis is presented through a series of Tableau dashboards, each designed to reveal specific aspects of the Airbnb market in NYC.</run>
                              </formatted-text>
                            </zone>
                          </dashboard>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Total View' captured-sheet='Total view' id='2'>
                        <capturedDeltas>
