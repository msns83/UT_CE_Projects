                                <encoding attr='space' class='0' field='[federated.1rbar2h1wninja12rha9k1s7j01s].[none:Longitude:qk]' field-type='quantitative' projection='EPSG:3857' scope='cols' type='space' />
                              </style-rule>
                            </style>
